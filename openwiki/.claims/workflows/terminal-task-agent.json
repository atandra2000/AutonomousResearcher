    },
    {
      "id": "claim_fd9ff40c999d4afea14d021757261b75",
      "statement": "Task configuration defaults to a non-mutating, non-testing legacy turn: `dry_run=True`, `run_tests=False`, `test_command=\"uv run pytest\"`, a 600-second test timeout, streaming enabled, delegation disabled, and a default repair cap of two constrained to 0–10.",
      "evidence": [
        {
          "resource": "repo://src/research_engineer/cli/__init__.py#L3204-L3243",
          "version": "repo-lines-v1:sha256:2b6b1ec6b1070ff39751248e3cefea606c6220acc59ddabdb98b454123466b13:"
