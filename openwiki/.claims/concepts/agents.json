    {
      "id": "claim_9042268304a74d95a3d54b33f146d36a",
      "statement": "A research-loop run creates and persists a running loop record, repeatedly recalls context and executes iterations, persists each iteration, updates metric and cost state, records memory, checks stopping conditions, finalizes persistence, and attempts report generation.",
      "evidence": [
        {
          "resource": "repo://src/research_engineer/agents/research_loop_agent.py#L222-L406",
          "version": "repo-lines-v1:sha256:ac7d0405d755e493d0c7050820f67bd6ef8629a2fc623e216379e45cc65f0fab:"
        }
