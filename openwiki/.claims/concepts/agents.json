    {
      "id": "claim_785a04bf2e4d45a78f79309bb741d46e",
      "statement": "`CodingAgent.implement()` analyzes optional paper and repository context, generates code and patches, self-reviews, generates tests, plans migration and rollback, and returns report artifacts; its declared contract is patch-first rather than direct code modification.",
      "evidence": [
        {
          "resource": "repo://src/research_engineer/agents/coding_agent.py#L126-L299",
