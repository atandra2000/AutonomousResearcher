# E7 deployment configuration — copy to deploy/.env and fill in.
# Everything production-sensitive is deliberately required.

# --- Required ---
POSTGRES_PASSWORD=change-me-strong
RE_SERVICE_API_TOKEN=change-me-long-random-token

# --- Optional (defaults shown) ---
POSTGRES_USER=research
POSTGRES_DB=research_engineer
API_PORT=8000

# Restricted CORS: comma-separated origins. Empty = no CORS headers.
RE_SERVICE_CORS_ORIGINS=

# Runtime limits / worker behaviour
RE_WORKER_CONCURRENCY=4
RE_STALE_RUN_TIMEOUT_SECONDS=120
RE_QUEUE_POLL_SECONDS=0.5
RE_DEFAULT_MAX_STEPS=25
RE_DEFAULT_MAX_RUNTIME_SECONDS=600

# Optional artificial pause per agent step (testing/demos only).
RE_STEP_DELAY_SECONDS=0

# Telemetry endpoint is wired to the in-stack collector automatically.
