# E7 deployment configuration — copy to deploy/.env and fill in.
# Everything production-sensitive is deliberately required.

# --- Required ---
POSTGRES_PASSWORD=change-me-strong
RE_SERVICE_API_TOKEN=change-me-long-random-token
AUTH_SECRET=generate-a-long-random-auth-secret
AUTH_OIDC_ISSUER=https://your-identity-provider.example.com
AUTH_OIDC_CLIENT_ID=research-engineer-console
AUTH_OIDC_CLIENT_SECRET=provision-in-your-identity-provider

# --- Optional (defaults shown) ---
POSTGRES_USER=research
POSTGRES_DB=research_engineer
API_PORT=8000
WEB_PORT=3000

# Restricted CORS: comma-separated origins. Empty = no CORS headers.
RE_SERVICE_CORS_ORIGINS=

# Runtime limits / worker behaviour
RE_WORKER_CONCURRENCY=4
RE_STALE_RUN_TIMEOUT_SECONDS=120
RE_QUEUE_POLL_SECONDS=0.5
RE_DEFAULT_MAX_STEPS=25
RE_DEFAULT_MAX_RUNTIME_SECONDS=600

# LangGraph uses the service Postgres database by default in Docker Compose.
# Set RE_LANGGRAPH_CHECKPOINT_DSN outside Compose to enable durable graph snapshots.

# Optional artificial pause per agent step (testing/demos only).
RE_STEP_DELAY_SECONDS=0

# Optional LangSmith tracing. Leave disabled until a server-side secret is
# provisioned; never put a real key in this example file.
LANGSMITH_TRACING=false
LANGSMITH_PROJECT=research-engineer
LANGSMITH_ENDPOINT=
LANGSMITH_API_KEY=
LANGCHAIN_CALLBACKS_BACKGROUND=true

# Telemetry endpoint is wired to the in-stack collector automatically.
